generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadSource {
  property_inquiry
  business_inquiry
  general_contact
  sponsor_inquiry
  urgent_stay
  standby_host
  concierge_request
  alerts_signup
}

enum LeadStatus {
  new
  contacted
  closed
}

enum SponsorLevel {
  local
  category
  festival
}

enum SponsorshipStatus {
  pending
  active
  expired
}

enum BoardPostType {
  need
  availability
}

enum BoardPostStatus {
  pending
  active
  closed
  removed
}

model Lead {
  id           String     @id @default(cuid())
  sourceType   LeadSource
  propertySlug String?
  businessSlug String?
  visitorName  String
  visitorEmail String
  visitorPhone String?
  message      String
  status       LeadStatus @default(new)
  createdAt    DateTime   @default(now())
}

model PropertySubmission {
  id                String     @id @default(cuid())
  name              String
  email             String
  phone             String?
  propertyAddress   String
  propertyType      String
  bedrooms          Int
  bathrooms         Int
  capacity          Int
  availabilityDates String?
  description       String
  bookingUrl        String?
  shortNotice       Boolean    @default(false)
  status            LeadStatus @default(new)
  createdAt         DateTime   @default(now())
}

// Public marketplace user (a traveler or a host). Distinct from the single
// admin operator. Authenticated by passwordless email magic link.
model BoardUser {
  id        String           @id @default(cuid())
  email     String           @unique
  name      String?
  createdAt DateTime         @default(now())
  posts     BoardPost[]
  tokens    MagicLinkToken[]
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  userId    String
  user      BoardUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model BoardPost {
  id        String          @id @default(cuid())
  authorId  String
  author    BoardUser       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type      BoardPostType
  area      String
  dates     String
  partySize String?
  budget    String?
  notes     String
  status    BoardPostStatus @default(pending)
  createdAt DateTime        @default(now())

  @@index([status, type])
}

model Sponsorship {
  id           String            @id @default(cuid())
  businessName String
  contactName  String?
  contactEmail String
  contactPhone String?
  level        SponsorLevel
  placement    String
  amountCents  Int?
  status       SponsorshipStatus @default(pending)
  startDate    DateTime?
  endDate      DateTime?
  notes        String?
  createdAt    DateTime          @default(now())
}
