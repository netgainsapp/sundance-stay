generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadSource {
  property_inquiry
  business_inquiry
  general_contact
  sponsor_inquiry
  urgent_stay
  standby_host
  concierge_request
  alerts_signup
}

enum LeadStatus {
  new
  contacted
  closed
}

enum SponsorLevel {
  local
  category
  festival
}

enum SponsorshipStatus {
  pending
  active
  expired
}

enum BoardPostType {
  need
  availability
}

enum BoardPostStatus {
  pending
  active
  closed
  removed
}

enum ThreadStatus {
  open
  closed
}

enum BoardUserStatus {
  active
  suspended
}

enum ReportTargetType {
  post
  thread
}

enum ReportStatus {
  open
  reviewed
  dismissed
}

enum GeneratedPostType {
  neighborhood
  category
  cornerstone
}

enum GeneratedPostStatus {
  draft
  published
  unpublished
}

enum BlogTopicStatus {
  candidate
  used
  skipped_thin
}

model Lead {
  id           String     @id @default(cuid())
  sourceType   LeadSource
  propertySlug String?
  businessSlug String?
  visitorName  String
  visitorEmail String
  visitorPhone String?
  message      String
  status       LeadStatus @default(new)
  createdAt    DateTime   @default(now())
}

model PropertySubmission {
  id                String     @id @default(cuid())
  name              String
  email             String
  phone             String?
  propertyAddress   String
  propertyType      String
  bedrooms          Int
  bathrooms         Int
  capacity          Int
  availabilityDates String?
  description       String
  bookingUrl        String?
  shortNotice       Boolean    @default(false)
  status            LeadStatus @default(new)
  createdAt         DateTime   @default(now())
}

// Public marketplace user (a traveler or a host). Distinct from the single
// admin operator. Authenticated by passwordless email magic link.
model BoardUser {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String?
  status          BoardUserStatus  @default(active)
  createdAt       DateTime         @default(now())
  posts           BoardPost[]
  tokens          MagicLinkToken[]
  threadsStarted  Thread[]         @relation("ThreadInitiator")
  threadsReceived Thread[]         @relation("ThreadRecipient")
  messages        Message[]        @relation("MessageSender")
}

// A user-submitted report of a post or conversation, for admin moderation.
model Report {
  id         String           @id @default(cuid())
  targetType ReportTargetType
  targetId   String
  reporterId String?
  reason     String
  status     ReportStatus     @default(open)
  createdAt  DateTime         @default(now())

  @@index([status])
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  userId    String
  user      BoardUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model BoardPost {
  id        String          @id @default(cuid())
  authorId  String
  author    BoardUser       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type      BoardPostType
  area      String
  dates     String
  partySize String?
  budget    String?
  notes     String
  status    BoardPostStatus @default(pending)
  createdAt DateTime        @default(now())
  threads   Thread[]

  @@index([status, type])
}

// A private conversation between the post author and one other user, scoped to
// a single post. In Phase 3 a paid unlock will gate thread creation; the model
// is ready for it. Contact happens in app, so emails are never exposed.
model Thread {
  id          String       @id @default(cuid())
  postId      String
  post        BoardPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  initiatorId String
  initiator   BoardUser    @relation("ThreadInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   BoardUser    @relation("ThreadRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status      ThreadStatus @default(open)
  createdAt   DateTime     @default(now())
  messages    Message[]

  @@unique([postId, initiatorId])
  @@index([recipientId])
  @@index([initiatorId])
}

model Message {
  id        String    @id @default(cuid())
  threadId  String
  thread    Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    BoardUser @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([threadId])
}

// An auto-generated blog post. Curated posts live in src/content/blog.ts; these
// are produced by the engine and render alongside them when published.
model GeneratedPost {
  id               String              @id @default(cuid())
  slug             String              @unique
  title            String
  dek              String?
  excerpt          String
  bodyMd           String
  postType         GeneratedPostType
  status           GeneratedPostStatus @default(draft)
  topicKey         String
  dataSnapshot     Json?
  seoTitle         String?
  seoDescription   String?
  tags             Json
  guardrailReasons Json?
  featuredImage    String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  publishedAt      DateTime?

  @@index([status, publishedAt])
  @@index([topicKey])
}

model BlogTopic {
  id            String          @id @default(cuid())
  topicKey      String          @unique
  label         String
  postType      GeneratedPostType
  source        String
  status        BlogTopicStatus @default(candidate)
  score         Float           @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime        @default(now())
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Sponsorship {
  id           String            @id @default(cuid())
  businessName String
  contactName  String?
  contactEmail String
  contactPhone String?
  level        SponsorLevel
  placement    String
  amountCents  Int?
  status       SponsorshipStatus @default(pending)
  startDate    DateTime?
  endDate      DateTime?
  notes        String?
  createdAt    DateTime          @default(now())
}
